# Medi AI — environment variables
# Copy these into your host's Environment settings (e.g. Render dashboard).
# You do NOT need all 10 keys — the app works with any one of them,
# and automatically falls back to the next available provider if one fails.

# Required: session security (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# AI provider keys (add the ones you have)
GROQ_API_KEY=
SARVAM_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
COHERE_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
PLUGSKY_API_KEY=

# Optional: Plugsky endpoint + model (if it differs from the default)
# PLUGSKY_BASE_URL=https://api.plugsky.com/v1/chat/completions
# PLUGSKY_MODEL=gpt-4o-mini

# Optional: override any provider's model, e.g.
# GROQ_MODEL=llama-3.3-70b-versatile
