# Medi AI — environment variables
# Copy these into your host's Environment settings (e.g. Render dashboard).
# You do NOT need all 10 keys — the app works with any one of them,
# and automatically falls back to the next available provider if one fails.

# Required: session security (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Required: PostgreSQL connection string (permanent database).
# Recommended: create a free project at https://neon.tech and copy the
# pooled connection string. All data (users, chats, reports, payments)
# lives here and survives redeploys.
DATABASE_URL=postgresql://user:password@host/dbname

# AI provider keys (add the ones you have)
GROQ_API_KEY=
SARVAM_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
COHERE_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
PLUGSKY_API_KEY=

# Optional: Plugsky endpoint + model (if it differs from the default)
# PLUGSKY_BASE_URL=https://api.plugsky.com/v1/chat/completions
# PLUGSKY_MODEL=gpt-4o-mini

# Optional: override any provider's model, e.g.
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: payments (Razorpay) — enable buying Plus/Pro plans in the Pricing page
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Optional: WhatsApp bot (Meta WhatsApp Cloud API)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_VERIFY_TOKEN=medi-ai
